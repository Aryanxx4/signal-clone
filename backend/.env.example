# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./signal.db
MEDIA_DIR=./media
# Fixed OTP for mocked phone verification
MOCK_OTP=123456
# Show the OTP hint on the onboarding screen
DEMO_MODE=true
# Seed demo data when the database is empty
SEED_ON_STARTUP=true
